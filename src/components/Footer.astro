---
const year = new Date().getFullYear();

const socials = [
  {
    name: 'GitHub',
    href: 'https://github.com/LuqueGabriel01',
    icon: 'M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.73 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.58.24 2.75.12 3.04.73.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/luque-gabriel/',
    icon: 'M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z',
  },
  {
    name: 'Email',
    href: 'mailto:luquegabrielcv@gmail.com',
    icon: 'M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5v-13Zm2.2.5 7.8 6.24L19.8 6H4.2Zm-.2 1.56V18h16V7.56l-7.42 5.94a1 1 0 0 1-1.16 0L4 7.56Z',
  },
];

const navLinks = [
  { label: 'Home', href: '/#home' },
  { label: 'Stack', href: '/#stack' },
  { label: 'Proyectos', href: '/#projects' },
  { label: 'Contacto', href: '/#contact' },
  { label: 'CV', href: '/cv' },
];
---

<footer class="border-t border-slate-800 bg-[#0B1120] text-slate-400">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-6 py-10 sm:flex-row sm:justify-between sm:px-10 lg:px-16">
    <div class="flex flex-col items-center gap-1 sm:items-start">
      <a
        href="/#home"
        class="text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:text-emerald-400"
      >
        Gabriel Luque
      </a>
      <span class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">
        Backend Developer
      </span>
    </div>

    <nav aria-label="Navegación del pie de página">
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-slate-400">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="transition-colors duration-300 hover:text-emerald-400">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      {socials.map((social) => (
        <a
          href={social.href}
          target={social.name !== 'Email' ? '_blank' : undefined}
          rel={social.name !== 'Email' ? 'noopener noreferrer' : undefined}
          aria-label={social.name}
          class="text-slate-400 transition-colors duration-300 hover:text-emerald-400"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d={social.icon} />
          </svg>
        </a>
      ))}
    </div>
  </div>

  <div class="border-t border-slate-800 px-6 py-4 text-center font-mono text-xs uppercase tracking-[0.2em] text-slate-600">
    © {year} Gabriel Luque
  </div>
</footer>
