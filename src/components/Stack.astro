---
const groups = [
  {
    n: '01',
    i18nKey: 'core',
    title: 'Core',
    featured: true,
    items: [
      { name: 'Java', slug: 'openjdk' },
      { name: 'Spring Boot', slug: 'springboot' },
      { name: 'Spring Security', slug: 'spring' },
      { name: 'Spring Cloud', slug: 'spring' },
      { name: 'Hibernate', slug: 'hibernate' },
      { name: 'JPA', slug: null },
      { name: 'JUnit', slug: 'junit5' },
      { name: 'Mockito', slug: null },
    ],
  },
  {
    n: '02',
    i18nKey: 'data',
    title: 'Datos',
    items: [
      { name: 'PostgreSQL', slug: 'postgresql' },
      { name: 'MySQL', slug: 'mysql' },
      { name: 'Redis', slug: 'redis' },
    ],
  },
  {
    n: '03',
    i18nKey: 'messaging',
    title: 'Mensajería & Resiliencia',
    items: [
      { name: 'Kafka', slug: 'apachekafka' },
      { name: 'Resilience4j', slug: null },
    ],
  },
  {
    n: '04',
    i18nKey: 'quality',
    title: 'Calidad de código',
    items: [
      { name: 'Checkstyle', slug: null },
      { name: 'PMD', slug: null },
      { name: 'JaCoCo', slug: null },
      { name: 'Spotless', slug: null },
    ],
  },
  {
    n: '05',
    i18nKey: 'infra',
    title: 'Infraestructura & CI/CD',
    items: [
      { name: 'Docker', slug: 'docker' },
      { name: 'GitHub Actions', slug: 'githubactions' },
    ],
  },
];

const learning = [
  { name: 'Kubernetes', slug: 'kubernetes' },
  { name: 'Cassandra', slug: 'apachecassandra' },
  { name: 'AWS', slug: null },
];
---

<section
  id="stack"
  class="reveal-section relative flex min-h-screen scroll-mt-24 flex-col justify-center overflow-hidden bg-[#0B1120] px-6 py-16 text-white sm:px-10 lg:px-16"
>
  <div class="mx-auto w-full max-w-7xl">
    <div class="reveal max-w-6xl">
      <span
        class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
        data-i18n="stack.label"
      >
        Sobre mí
      </span>

      <p
        class="mt-6 text-2xl font-medium leading-snug text-slate-200 sm:text-3xl lg:text-4xl"
        data-i18n="stack.intro"
      >
        Desarrollo backends enfocado en una arquitectura sólida, aplicando buenas prácticas y
        priorizando la calidad del código para crear soluciones mantenibles y escalables.
      </p>

      <p
        class="mt-6 max-w-3xl text-sm leading-relaxed text-slate-500 sm:text-base"
        data-i18n="stack.subintro"
      >
        Trabajo en equipo siguiendo prácticas ágiles, organizando el trabajo mediante issues, ramas
        y pull requests, y cuidando tanto la calidad del código como la documentación del proyecto.
      </p>
    </div>

    <div class="mt-10 border border-slate-800 bg-slate-800">
      <div class="reveal bg-[#0B1120] p-6 sm:p-8">
        <div class="mb-8 flex items-center gap-3">
          <span class="font-mono text-xs text-slate-600">{groups[0].n}</span>
          <span class="h-px w-8 bg-slate-800"></span>
          <h3
            class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400"
            data-i18n={`stack.groups.${groups[0].i18nKey}`}
          >
            {groups[0].title}
          </h3>
        </div>

        <ul class="grid gap-x-8 gap-y-5 sm:grid-cols-3 lg:grid-cols-6">
          {groups[0].items.map((item) => (
            <li class="group flex items-center gap-3 text-slate-400 transition-colors duration-300 hover:text-emerald-400">
              {item.slug ? (
                <span
                  aria-hidden="true"
                  class="h-5 w-5 shrink-0 bg-slate-400 opacity-60 transition-colors duration-300 group-hover:bg-emerald-400 group-hover:opacity-100"
                  style={`mask-image:url(https://cdn.simpleicons.org/${item.slug}); mask-size:contain; mask-repeat:no-repeat; mask-position:center; -webkit-mask-image:url(https://cdn.simpleicons.org/${item.slug}); -webkit-mask-size:contain; -webkit-mask-repeat:no-repeat; -webkit-mask-position:center;`}
                ></span>
              ) : (
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-slate-700 transition-colors duration-300 group-hover:bg-emerald-400"></span>
              )}
              <span class="text-sm font-medium">{item.name}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="grid gap-px border-t border-slate-800 bg-slate-800 sm:grid-cols-2 lg:grid-cols-4">
        {groups.slice(1).map((group, gi) => (
          <div
            class="reveal bg-[#0B1120] p-6 sm:p-8"
            style={`transition-delay: ${(gi + 1) * 80}ms;`}
          >
            <div class="mb-8 flex items-center gap-3">
              <span class="font-mono text-xs text-slate-600">{group.n}</span>
              <span class="h-px w-8 bg-slate-800"></span>
              <h3
                class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400"
                data-i18n={`stack.groups.${group.i18nKey}`}
              >
                {group.title}
              </h3>
            </div>

            <ul class="grid gap-x-6 gap-y-5">
              {group.items.map((item) => (
                <li class="group flex items-center gap-3 text-slate-400 transition-colors duration-300 hover:text-emerald-400">
                  {item.slug ? (
                    <span
                      aria-hidden="true"
                      class="h-5 w-5 shrink-0 bg-slate-400 opacity-60 transition-colors duration-300 group-hover:bg-emerald-400 group-hover:opacity-100"
                      style={`mask-image:url(https://cdn.simpleicons.org/${item.slug}); mask-size:contain; mask-repeat:no-repeat; mask-position:center; -webkit-mask-image:url(https://cdn.simpleicons.org/${item.slug}); -webkit-mask-size:contain; -webkit-mask-repeat:no-repeat; -webkit-mask-position:center;`}
                    ></span>
                  ) : (
                    <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-slate-700 transition-colors duration-300 group-hover:bg-emerald-400"></span>
                  )}
                  <span class="text-sm font-medium">{item.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div
      class="reveal mt-px border border-slate-800 bg-[#0B1120] p-6 sm:p-8"
      style="transition-delay: 320ms;"
    >
      <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-slate-600">06</span>

            <span class="h-px w-8 bg-slate-800"></span>

            <h3
              class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400"
              data-i18n="stack.learningTitle"
            >
              Actualmente aprendiendo
            </h3>
          </div>

          <p class="mt-3 max-w-lg text-sm text-slate-600" data-i18n="stack.learningText">
            Tecnologías que estoy explorando para ampliar mis conocimientos en desarrollo backend,
            automatización e infraestructura.
          </p>
        </div>

        <ul class="flex flex-wrap gap-x-8 gap-y-5">
          {learning.map((item) => (
            <li class="group flex items-center gap-3 text-slate-400 transition-colors duration-300 hover:text-emerald-400">
              {item.slug ? (
                <img
                  src={`https://cdn.simpleicons.org/${item.slug}`}
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                  class="h-5 w-5 opacity-50 grayscale transition-all duration-300 group-hover:opacity-100 group-hover:grayscale-0"
                />
              ) : (
                <span class="h-1.5 w-1.5 rounded-full bg-slate-700"></span>
              )}

              <span class="text-sm font-medium">{item.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  .reveal-section.is-visible .reveal {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function initAbout() {
    const section = document.getElementById('stack');

    if (!section) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add('is-visible');
            observer.disconnect();
          }
        });
      },
      { threshold: 0.2 },
    );

    observer.observe(section);
  }

  initAbout();
  document.addEventListener('astro:page-load', initAbout);
</script>
