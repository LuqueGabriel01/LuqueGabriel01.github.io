---
const email = 'luquegabrielcv@gmail.com';

const contactLinks = [
  {
    name: 'Email',
    value: email,
    href: `mailto:${email}`,
    icon: 'M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5v-13Zm2.2.5 7.8 6.24L19.8 6H4.2Zm-.2 1.56V18h16V7.56l-7.42 5.94a1 1 0 0 1-1.16 0L4 7.56Z',
  },
  {
    name: 'LinkedIn',
    value: 'linkedin.com/in/luque-gabriel',
    href: 'https://www.linkedin.com/in/luque-gabriel/',
    icon: 'M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z',
  },
  {
    name: 'GitHub',
    value: 'github.com/LuqueGabriel01',
    href: 'https://github.com/LuqueGabriel01',
    icon: 'M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.73 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.58.24 2.75.12 3.04.73.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z',
  },
];
---

<section
  id="contact"
  class="reveal-section relative flex scroll-mt-24 flex-col justify-center overflow-hidden bg-[#0B1120] px-6 py-24 text-white sm:px-10 lg:px-16"
>
  <div class="mx-auto w-full max-w-7xl">
    <div class="reveal max-w-6xl">
      <span
        class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
        data-i18n="contact.label"
      >
        Contacto
      </span>
    </div>

    <div class="reveal mt-14 border border-slate-800" style="transition-delay: 120ms;">
      <div class="border-b border-slate-800 p-6 sm:p-8">
        <h3 class="text-2xl font-bold sm:text-3xl" data-i18n="contact.form.title">
          Trabajemos juntos
        </h3>
        <p
          class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-400 sm:text-base"
          data-i18n="contact.form.intro"
        >
          Cuéntame qué tienes en mente. Rellena los campos y se prepara un correo listo para enviar;
          no se envía nada desde esta web, se abre tu correo con el mensaje ya escrito.
        </p>
      </div>

      <form
        id="contact-form"
        data-email={email}
        novalidate
        class="grid gap-px bg-slate-800 lg:grid-cols-2"
      >
        <div class="flex flex-col gap-5 bg-[#0B1120] p-6 sm:p-8">
          <div>
            <label
              for="cf-type"
              class="block font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
              data-i18n="contact.form.typeLabel"
            >
              Motivo
            </label>
            <select
              id="cf-type"
              name="type"
              class="mt-2 w-full border border-slate-800 bg-[#0B1120] px-3 py-2.5 text-sm text-white transition-colors focus:border-emerald-400 focus:outline-none"
            >
              <option value="job" data-i18n="contact.form.types.job">
                Oferta de trabajo
              </option>
              <option value="collab" data-i18n="contact.form.types.collab">
                Colaboración
              </option>
              <option value="question" data-i18n="contact.form.types.question">
                Consulta
              </option>
            </select>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label
                for="cf-name"
                class="block font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
                data-i18n="contact.form.nameLabel"
              >
                Nombre
              </label>
              <input
                id="cf-name"
                name="name"
                type="text"
                autocomplete="name"
                maxlength="80"
                required
                placeholder="Tu nombre"
                data-i18n-attr="placeholder:contact.form.namePlaceholder"
                class="mt-2 w-full border border-slate-800 bg-transparent px-3 py-2.5 text-sm text-white transition-colors placeholder:text-slate-600 focus:border-emerald-400 focus:outline-none"
              />
            </div>
            <div>
              <label
                for="cf-company"
                class="block font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
                data-i18n="contact.form.companyLabel"
              >
                Empresa (opcional)
              </label>
              <input
                id="cf-company"
                name="company"
                type="text"
                autocomplete="organization"
                maxlength="80"
                placeholder="Nombre de la empresa"
                data-i18n-attr="placeholder:contact.form.companyPlaceholder"
                class="mt-2 w-full border border-slate-800 bg-transparent px-3 py-2.5 text-sm text-white transition-colors placeholder:text-slate-600 focus:border-emerald-400 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label
              for="cf-subject"
              class="block font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
              data-i18n="contact.form.subjectLabel"
            >
              Puesto, proyecto o tema (opcional)
            </label>
            <input
              id="cf-subject"
              name="subject"
              type="text"
              maxlength="120"
              placeholder="Ej. Desarrollador Java backend"
              data-i18n-attr="placeholder:contact.form.subjectPlaceholder"
              class="mt-2 w-full border border-slate-800 bg-transparent px-3 py-2.5 text-sm text-white transition-colors placeholder:text-slate-600 focus:border-emerald-400 focus:outline-none"
            />
          </div>

          <div>
            <label
              for="cf-link"
              class="block font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
              data-i18n="contact.form.linkLabel"
            >
              Enlace (opcional)
            </label>
            <input
              id="cf-link"
              name="link"
              type="url"
              inputmode="url"
              maxlength="300"
              placeholder="https://…"
              data-i18n-attr="placeholder:contact.form.linkPlaceholder"
              class="mt-2 w-full border border-slate-800 bg-transparent px-3 py-2.5 text-sm text-white transition-colors placeholder:text-slate-600 focus:border-emerald-400 focus:outline-none"
            />
          </div>

          <div>
            <label
              for="cf-message"
              class="block font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
              data-i18n="contact.form.messageLabel"
            >
              Mensaje
            </label>
            <textarea
              id="cf-message"
              name="message"
              rows="6"
              maxlength="1500"
              required
              placeholder="Cuéntame un poco más: contexto, plazos, siguiente paso…"
              data-i18n-attr="placeholder:contact.form.messagePlaceholder"
              class="mt-2 w-full border border-slate-800 bg-transparent px-3 py-2.5 text-sm text-white transition-colors placeholder:text-slate-600 focus:border-emerald-400 focus:outline-none resize-y"
            ></textarea>
          </div>
        </div>

        <div class="flex flex-col gap-5 bg-[#0B1120] p-6 sm:p-8">
          <div>
            <span
              class="block font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
              data-i18n="contact.form.previewLabel"
            >
              Vista previa del correo
            </span>
            <p class="mt-2 break-words font-mono text-xs text-slate-400">
              <span data-i18n="contact.form.subjectPreviewLabel">Asunto</span>:
              <span id="cf-subject-preview" class="text-slate-200"></span>
            </p>
            <pre
              id="cf-preview"
              aria-live="polite"
              class="mt-3 min-h-64 whitespace-pre-wrap break-words border border-slate-800 bg-slate-900/40 p-4 font-sans text-sm leading-relaxed text-slate-300"
            ></pre>
          </div>

          <p
            id="cf-hint"
            class="font-mono text-xs uppercase tracking-wide text-slate-600"
            data-i18n="contact.form.hint"
          >
            Rellena tu nombre y el mensaje para activar los botones.
          </p>

          <div class="flex flex-wrap gap-3">
            <a
              id="cf-gmail"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border px-4 py-2.5 font-mono text-xs uppercase tracking-wide transition-colors border-emerald-400 text-emerald-400 hover:bg-emerald-400 hover:text-[#0B1120]"
            >
              <span data-i18n="contact.form.openGmail">Abrir en Gmail</span>
              <span aria-hidden="true">→</span>
            </a>
            <a
              id="cf-mail"
              href="#"
              class="inline-flex items-center gap-2 border px-4 py-2.5 font-mono text-xs uppercase tracking-wide transition-colors border-slate-700 text-white hover:border-emerald-400 hover:text-emerald-400"
            >
              <span data-i18n="contact.form.openMail">Abrir en mi correo</span>
              <span aria-hidden="true">→</span>
            </a>
            <button
              id="cf-copy"
              type="button"
              class="inline-flex items-center gap-2 border px-4 py-2.5 font-mono text-xs uppercase tracking-wide transition-colors border-slate-700 text-slate-300 hover:border-emerald-400 hover:text-emerald-400"
            >
              <span id="cf-copy-label" data-i18n="contact.form.copy">
                Copiar mensaje
              </span>
            </button>
          </div>
        </div>
      </form>
    </div>

    <div
      class="reveal mt-14 grid gap-px border border-slate-800 bg-slate-800 sm:grid-cols-3"
      style="transition-delay: 180ms;"
    >
      {contactLinks.map((link) => (
        <a
          href={link.href}
          target={link.name !== 'Email' ? '_blank' : undefined}
          rel={link.name !== 'Email' ? 'noopener noreferrer' : undefined}
          class="group flex flex-col gap-6 bg-[#0B1120] p-6 transition-colors duration-300 hover:bg-slate-900 sm:p-8"
        >
          <div class="flex items-center justify-between">
            <svg
              viewBox="0 0 24 24"
              class="h-6 w-6 text-slate-500 transition-colors duration-300 group-hover:text-emerald-400"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={link.icon} />
            </svg>
            <span class="text-lg text-slate-600 transition-all duration-300 group-hover:translate-x-1 group-hover:text-emerald-400">
              →
            </span>
          </div>

          <div>
            <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">{link.name}</h3>
            <p class="mt-2 break-all text-sm font-medium text-white transition-colors duration-300 group-hover:text-emerald-400 sm:text-base">
              {link.value}
            </p>
          </div>
        </a>
      ))}
    </div>

    <div
      class="reveal mt-10 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
      style="transition-delay: 220ms;"
    >
      <span data-i18n="contact.location">Madrid, España</span>
      <span class="h-1 w-1 rounded-full bg-slate-700"></span>
      <span data-i18n="contact.availability">Disponible para trabajar</span>
    </div>
  </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  .reveal-section.is-visible .reveal {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  import { translations } from '../i18n/translations';

  function initContact() {
    const section = document.getElementById('contact');

    if (!section) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add('is-visible');
            observer.disconnect();
          }
        });
      },
      { threshold: 0.2 },
    );

    observer.observe(section);
  }

  initContact();
  document.addEventListener('astro:page-load', initContact);

  type FormLang = 'es' | 'en';
  type ReasonKey = 'job' | 'collab' | 'question';

  function currentLang(): FormLang {
    return document.documentElement.lang === 'en' ? 'en' : 'es';
  }

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;

    if (!form || form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';

    const email = form.dataset.email ?? '';
    const field = (id: string) => document.getElementById(id) as HTMLInputElement;
    const typeEl = document.getElementById('cf-type') as HTMLSelectElement;
    const messageEl = document.getElementById('cf-message') as HTMLTextAreaElement;
    const previewEl = document.getElementById('cf-preview') as HTMLElement;
    const subjectPreviewEl = document.getElementById('cf-subject-preview') as HTMLElement;
    const gmailEl = document.getElementById('cf-gmail') as HTMLAnchorElement;
    const mailEl = document.getElementById('cf-mail') as HTMLAnchorElement;
    const copyEl = document.getElementById('cf-copy') as HTMLButtonElement;
    const copyLabelEl = document.getElementById('cf-copy-label') as HTMLElement;
    const hintEl = document.getElementById('cf-hint') as HTMLElement;

    let subject = '';
    let body = '';
    let valid = false;
    let copyTimer: number | undefined;

    function build() {
      const f = translations[currentLang()].contact.form;
      const m = f.mail;
      const type = typeEl.value as ReasonKey;
      const name = field('cf-name').value.trim();
      const company = field('cf-company').value.trim();
      const topic = field('cf-subject').value.trim();
      const link = field('cf-link').value.trim();
      const message = messageEl.value.trim();

      const who = name || m.namePlaceholder;
      const intro = `${m.iam} ${who}${company ? `, ${m.fromCompany} ${company}` : ''}. ${m.writing} ${m.reasons[type]}${topic ? `: ${topic}` : ''}.`;

      subject = `${m.subjectPrefix}: ${f.types[type]}${name ? ` — ${name}` : ''}`;
      body = [
        m.greeting,
        '',
        intro,
        '',
        message || m.messagePlaceholder,
        ...(link ? ['', `${m.link}: ${link}`] : []),
        '',
        m.closing,
        who,
      ].join('\n');

      valid = name.length > 0 && message.length > 0;

      subjectPreviewEl.textContent = subject;
      previewEl.textContent = body;

      const query = `subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      mailEl.href = valid ? `mailto:${email}?${query}` : '#';
      gmailEl.href = valid
        ? `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
        : '#';

      [gmailEl, mailEl].forEach((el) => {
        el.setAttribute('aria-disabled', String(!valid));
        el.classList.toggle('pointer-events-none', !valid);
        el.classList.toggle('opacity-40', !valid);
        el.tabIndex = valid ? 0 : -1;
      });
      copyEl.disabled = !valid;
      copyEl.classList.toggle('opacity-40', !valid);
      copyEl.classList.toggle('pointer-events-none', !valid);
      hintEl.classList.toggle('hidden', valid);
    }

    function flashCopy(key: 'copied' | 'copyFailed') {
      const f = translations[currentLang()].contact.form;
      copyLabelEl.textContent = f[key];
      window.clearTimeout(copyTimer);
      copyTimer = window.setTimeout(() => {
        copyLabelEl.textContent = translations[currentLang()].contact.form.copy;
      }, 2000);
    }

    async function copyMessage() {
      if (!valid) return;
      const text = `${subject}\n\n${body}`;

      try {
        await navigator.clipboard.writeText(text);
        flashCopy('copied');
      } catch {
        flashCopy('copyFailed');
      }
    }

    form.addEventListener('input', build);
    form.addEventListener('change', build);
    form.addEventListener('submit', (event) => event.preventDefault());
    [gmailEl, mailEl].forEach((el) =>
      el.addEventListener('click', (event) => {
        if (!valid) event.preventDefault();
      }),
    );
    copyEl.addEventListener('click', copyMessage);

    new MutationObserver(build).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['lang'],
    });

    build();
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
