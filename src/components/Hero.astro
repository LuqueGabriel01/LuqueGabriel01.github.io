---
---

<section
  id="home"
  class="relative flex min-h-screen scroll-mt-24 flex-col justify-between overflow-hidden bg-[#0B1120] px-6 pb-10 pt-32 text-white sm:px-10"
>
  <div class="flex flex-1 flex-col justify-center">
    <h1 class="text-[13vw] font-bold uppercase leading-[0.92] tracking-tight sm:text-[9vw] lg:text-[7.5rem]">
      <span class="reveal block" style="transition-delay: 80ms;">
        Gabriel
      </span>
      <span class="reveal block text-slate-500" style="transition-delay: 180ms;">
        Luque
      </span>
    </h1>

    <div
      class="reveal mt-8 flex flex-col gap-6 sm:mt-10 sm:flex-row sm:items-end sm:justify-between"
      style="transition-delay: 320ms;"
    >
      <p class="max-w-md text-base text-slate-400 sm:text-lg" data-i18n-html="hero.descriptionHtml">
        Desarrollador backend junior especializado en <span class="text-white">Java</span> y{' '}
        <span class="text-white">Spring Boot</span>. Me enfoco en construir APIs REST y sistemas
        basados en <span class="text-white">microservicios</span>, con autenticación segura,
        comunicación event-driven entre servicios y despliegue en contenedores con{' '}
        <span class="text-white">Docker</span>.
      </p>

      <a
        href="#projects"
        class="group inline-flex w-fit items-center gap-3 border-b border-white pb-1 text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:border-emerald-400 hover:text-emerald-400"
      >
        <span data-i18n="hero.cta">Ver proyectos</span>
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>

  <div
    class="reveal flex items-center justify-between font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
    style="transition-delay: 420ms;"
  >
    <span data-i18n="hero.location">Madrid, España</span>
    <span class="flex items-center gap-2">
      <span data-i18n="hero.scroll">Scroll</span>
      <span class="h-8 w-px animate-bounce bg-slate-600"></span>
    </span>
  </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }
  section.is-visible .reveal {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const hero = document.getElementById('home');
  requestAnimationFrame(() => {
    hero?.classList.add('is-visible');
  });
</script>
