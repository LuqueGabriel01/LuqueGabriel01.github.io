---
import { translations } from '../i18n/translations';

const t = translations.es.cv;
const repoLabel = translations.es.projects.links.repo;

const contact = [
  {
    label: 'Mail',
    value: 'luquegabrielcv@gmail.com',
    href: 'mailto:luquegabrielcv@gmail.com',
    external: false,
  },
  {
    label: 'GitHub',
    value: 'github.com/LuqueGabriel01',
    href: 'https://github.com/LuqueGabriel01',
    external: true,
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/luque-gabriel',
    href: 'https://www.linkedin.com/in/luque-gabriel/',
    external: true,
  },
];
---

<section class="min-h-screen bg-[#0B1120] px-6 pb-24 pt-32 text-white sm:px-10 lg:px-16">
  <div class="mx-auto w-full max-w-5xl">
    <header>
      <span
        class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
        data-i18n="cv.label"
      >
        {t.label}
      </span>
      <h1 class="mt-6 text-5xl font-bold uppercase leading-[0.95] tracking-tight sm:text-7xl">
        Gabriel <span class="text-slate-500">Luque</span>
      </h1>
      <p
        class="mt-4 font-mono text-sm uppercase tracking-[0.2em] text-emerald-400"
        data-i18n="cv.role"
      >
        {t.role}
      </p>

      <a
        href="/CV_Gabriel_Luque_Backend.pdf"
        download="CV_Gabriel_Luque.pdf"
        class="group mt-8 inline-flex w-fit items-center gap-3 border-b border-white pb-1 text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:border-emerald-400 hover:text-emerald-400"
      >
        <span data-i18n="cv.download">{t.download}</span>
        <span class="transition-transform duration-300 group-hover:translate-y-0.5">↓</span>
      </a>

      <dl class="mt-10 grid gap-px border border-slate-800 bg-slate-800 sm:grid-cols-2 lg:grid-cols-4">
        {contact.map((item) => (
          <div class="bg-[#0B1120] p-5">
            <dt class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">
              {item.label}
            </dt>
            <dd class="mt-2 break-all text-sm font-medium">
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="text-white transition-colors duration-300 hover:text-emerald-400"
              >
                {item.value}
              </a>
            </dd>
          </div>
        ))}
        <div class="bg-[#0B1120] p-5">
          <dt
            class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
            data-i18n="cv.locationLabel"
          >
            {t.locationLabel}
          </dt>
          <dd class="mt-2 text-sm font-medium text-white" data-i18n="cv.locationValue">
            {t.locationValue}
          </dd>
        </div>
      </dl>

      <p
        class="mt-10 w-full text-base text-slate-400 sm:text-lg"
        data-i18n-html="cv.summaryHtml"
        set:html={t.summaryHtml}
      />
    </header>

    <div class="mt-16">
      <section class="grid gap-6 border-t border-slate-800 py-10 md:grid-cols-[14rem_1fr] md:gap-12">
        <h2
          class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
          data-i18n="cv.sections.experience"
        >
          {t.sections.experience}
        </h2>
        <div>
          <h3 class="text-lg font-semibold text-white" data-i18n="cv.experience.role">
            {t.experience.role}
          </h3>
          <p class="mt-1 font-mono text-xs uppercase tracking-[0.15em] text-slate-500">
            Alebat Consulting · <span data-i18n="cv.experience.period">{t.experience.period}</span>
          </p>
          <p
            class="mt-4 text-slate-400"
            data-i18n-html="cv.experience.introHtml"
            set:html={t.experience.introHtml}
          />
          <ul class="mt-3 space-y-2 text-slate-400">
            {t.experience.items.map((item, i) => (
              <li class="flex gap-3">
                <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-emerald-400" />
                <span data-i18n-html={`cv.experience.items.${i}`} set:html={item} />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="grid gap-6 border-t border-slate-800 py-10 md:grid-cols-[14rem_1fr] md:gap-12">
        <h2
          class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
          data-i18n="cv.sections.projects"
        >
          {t.sections.projects}
        </h2>
        <div>
          <h3 class="text-lg font-semibold text-white">
            HotelReservationApp
            <span class="font-normal text-slate-500">
              - <span data-i18n="cv.projects.hotel.subtitle">{t.projects.hotel.subtitle}</span>
            </span>
          </h3>
          <p
            class="mt-4 text-slate-400"
            data-i18n-html="cv.projects.hotel.descriptionHtml"
            set:html={t.projects.hotel.descriptionHtml}
          />
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold uppercase tracking-wide">
            <a
              href="https://github.com/LuqueGabriel01/HotelReservationApp"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 border-b border-white pb-0.5 text-white transition-colors hover:border-emerald-400 hover:text-emerald-400"
            >
              <span data-i18n="projects.links.repo">{repoLabel}</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
          </div>
        </div>
      </section>

      <section class="grid gap-6 border-t border-slate-800 py-10 md:grid-cols-[14rem_1fr] md:gap-12">
        <h2
          class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
          data-i18n="cv.sections.education"
        >
          {t.sections.education}
        </h2>
        <ul class="space-y-8">
          {t.education.map((item, i) => (
            <li>
              <h3 class="text-lg font-semibold text-white" data-i18n={`cv.education.${i}.title`}>
                {item.title}
              </h3>
              <p class="mt-1 text-slate-400" data-i18n={`cv.education.${i}.detail`}>
                {item.detail}
              </p>
              <p
                class="mt-1 font-mono text-xs uppercase tracking-[0.15em] text-slate-500"
                data-i18n={`cv.education.${i}.period`}
              >
                {item.period}
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section class="grid gap-6 border-t border-slate-800 py-10 md:grid-cols-[14rem_1fr] md:gap-12">
        <h2
          class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
          data-i18n="cv.sections.languages"
        >
          {t.sections.languages}
        </h2>
        <p class="text-slate-400">
          <span class="font-semibold text-white" data-i18n="cv.languages.english">
            {t.languages.english}
          </span>
          <span class="mx-2 text-slate-600">·</span>
          <span data-i18n="cv.languages.englishLevel">{t.languages.englishLevel}</span>
        </p>
      </section>

      <section class="grid gap-6 border-y border-slate-800 py-10 md:grid-cols-[14rem_1fr] md:gap-12">
        <h2
          class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500"
          data-i18n="cv.sections.more"
        >
          {t.sections.more}
        </h2>
        <ul class="grid gap-2 text-slate-400 sm:grid-cols-2">
          {t.more.map((item, i) => (
            <li class="flex gap-3">
              <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-emerald-400" />
              <span data-i18n={`cv.more.${i}`}>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</section>
